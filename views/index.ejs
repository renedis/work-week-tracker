<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title><%= t.appTitle %></title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="app-header">
    <h1><%= t.appTitle %></h1>
    <div class="header-actions">
      <div class="language-toggle">
        <button onclick="setLanguage('en')" class="<%= lang === 'en' ? 'active' : '' %>">EN</button>
        <button onclick="setLanguage('uk')" class="<%= lang === 'uk' ? 'active' : '' %>">UA</button>
        <button onclick="setLanguage('nl')" class="<%= lang === 'nl' ? 'active' : '' %>">NL</button>
      </div>
      <a href="/logout" class="btn-logout"><%= t.logout %></a>
    </div>
  </header>

  <!-- Navigation Tabs -->
  <nav class="nav-tabs">
    <a href="/" class="nav-tab <%= activePage === 'schedule' ? 'active' : '' %>">
      <span class="nav-icon">📅</span>
      <span><%= t.navSchedule %></span>
    </a>
    <a href="/holidays" class="nav-tab <%= activePage === 'holidays' ? 'active' : '' %>">
      <span class="nav-icon">🏖️</span>
      <span><%= t.navHolidays %></span>
    </a>
  </nav>

  <main class="container">
    <!-- Week Selector -->
    <div class="card">
      <div class="week-selector-header">
        <h3><%= t.selectWeek %></h3>
        <div class="week-number-badge" id="weekNumberBadge"><%= t.week %> --</div>
      </div>
      <div class="week-selector-wrapper">
        <button type="button" class="week-nav-btn" id="prevWeekBtn" aria-label="Previous week">‹</button>
        <input type="week" id="weekSelector" class="week-input">
        <button type="button" class="week-nav-btn" id="nextWeekBtn" aria-label="Next week">›</button>
      </div>
    </div>

    <!-- Summary Cards -->
    <div class="summary-grid">
      <div class="summary-card">
        <span class="summary-label"><%= t.baseWorkweek %></span>
        <span class="summary-value">32 <%= t.hours %></span>
      </div>
      <div class="summary-card">
        <span class="summary-label"><%= t.cumulativeOvertime %></span>
        <span class="summary-value <%= cumulative >= 0 ? 'positive' : 'negative' %>" id="cumulativeValue">
          <%= cumulative >= 0 ? '+' : '' %><%= cumulative.toFixed(2) %> <%= t.hours %>
        </span>
      </div>
    </div>

    <!-- Weekly Schedule Form -->
    <div class="card">
      <h3><%= t.weeklySchedule %></h3>
      
      <form id="scheduleForm">
        <div class="schedule-table">
          <div class="schedule-header">
            <div class="col-day"><%= t.day %></div>
            <div class="col-actual"><%= t.actual %></div>
          </div>
          
          <% const days = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday']; %>
          <% days.forEach((day, index) => { %>
            <div class="schedule-row" data-day="<%= day %>" data-day-index="<%= index %>">
              <div class="col-day">
                <span class="day-name"><%= t[day] %></span>
                <span class="day-date" id="date-<%= day %>"></span>
              </div>
              <div class="col-actual">
                <div class="time-inputs">
                  <div class="time-select-group">
                    <select name="<%= day %>_start_hour" class="time-select hour-select"></select>
                    <span class="time-colon">:</span>
                    <select name="<%= day %>_start_min" class="time-select min-select"></select>
                  </div>
                  <span class="time-separator">-</span>
                  <div class="time-select-group">
                    <select name="<%= day %>_end_hour" class="time-select hour-select"></select>
                    <span class="time-colon">:</span>
                    <select name="<%= day %>_end_min" class="time-select min-select"></select>
                  </div>
                </div>
              </div>
            </div>
          <% }); %>
        </div>

        <!-- Week Totals -->
        <div class="totals-section">
          <div class="total-row">
            <span><%= t.weekTotalActual %>:</span>
            <span id="totalActual">0.00 <%= t.hours %></span>
          </div>
          <div class="total-row highlight">
            <span><%= t.weekDifference %>:</span>
            <span id="weekDifference">0.00 <%= t.hours %></span>
          </div>
        </div>

        <button type="submit" class="btn-primary btn-full"><%= t.save %></button>
      </form>
      
      <div id="saveMessage" class="save-message hidden"><%= t.saved %></div>
    </div>

    <!-- Previous Weeks -->
    <div class="card">
      <h3><%= t.previousWeeks %></h3>
      <div id="previousWeeks" class="previous-weeks">
        <% if (weeks.length === 0) { %>
          <p class="no-data"><%= t.noData %></p>
        <% } else { %>
          <% weeks.forEach(week => { %>
            <div class="week-entry" onclick="loadWeek('<%= week.weekStart %>')">
              <span class="week-date"><%= week.weekStart %></span>
              <span class="week-hours">
                <%= week.actualHours.toFixed(2) %> / <%= week.scheduledHours.toFixed(2) %> h
              </span>
              <span class="week-diff <%= week.difference >= 0 ? 'positive' : 'negative' %>">
                <%= week.difference >= 0 ? '+' : '' %><%= week.difference.toFixed(2) %> h
              </span>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>
  </main>

  <script>
    const hoursLabel = '<%= t.hours %>';
    const weekLabel = '<%= t.week %>';
    const days = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday'];
    const validMinutes = ['', '00', '15', '30', '45'];
    
    // Default schedule from server (in minutes from midnight, -1 = day off)
    const defaultSchedule = <%- JSON.stringify(defaultSchedule) %>;
    
    // Initialize all time select dropdowns
    function initTimeSelects() {
      // Populate hour selects (00-23)
      document.querySelectorAll('.hour-select').forEach(select => {
        select.innerHTML = '<option value="">--</option>';
        for (let h = 0; h < 24; h++) {
          const val = String(h).padStart(2, '0');
          select.innerHTML += `<option value="${val}">${val}</option>`;
        }
      });
      
      // Populate minute selects (only 00, 15, 30, 45)
      document.querySelectorAll('.min-select').forEach(select => {
        select.innerHTML = '<option value="">--</option>';
        ['00', '15', '30', '45'].forEach(m => {
          select.innerHTML += `<option value="${m}">${m}</option>`;
        });
      });
    }
    
    // Get time value from selects
    function getTimeFromSelects(day, type) {
      const hourSelect = document.querySelector(`select[name="${day}_${type}_hour"]`);
      const minSelect = document.querySelector(`select[name="${day}_${type}_min"]`);
      if (hourSelect.value && minSelect.value) {
        return `${hourSelect.value}:${minSelect.value}`;
      }
      return '';
    }
    
    // Set time value to selects
    function setTimeToSelects(day, type, timeStr) {
      const hourSelect = document.querySelector(`select[name="${day}_${type}_hour"]`);
      const minSelect = document.querySelector(`select[name="${day}_${type}_min"]`);
      if (!timeStr || timeStr === '') {
        hourSelect.value = '';
        minSelect.value = '';
        return;
      }
      const [hours, mins] = timeStr.split(':');
      hourSelect.value = hours;
      minSelect.value = mins;
    }
    
    // Convert minutes from midnight to HH:MM format
    function minutesToTime(minutes) {
      if (minutes < 0) return '';
      const hours = Math.floor(minutes / 60);
      const mins = minutes % 60;
      return `${String(hours).padStart(2, '0')}:${String(mins).padStart(2, '0')}`;
    }
    
    // Pre-fill actual hours with default scheduled times
    function prefillWithDefaults() {
      days.forEach(day => {
        const schedule = defaultSchedule[day];
        setTimeToSelects(day, 'start', minutesToTime(schedule.start));
        setTimeToSelects(day, 'end', minutesToTime(schedule.end));
      });
    }
    
    // Clear all actual hour fields
    function clearActualHours() {
      days.forEach(day => {
        setTimeToSelects(day, 'start', '');
        setTimeToSelects(day, 'end', '');
      });
    }
    
    // Load week data and pre-fill with defaults if no saved data
    async function loadWeekData(weekStart) {
      try {
        const res = await fetch(`/api/week/${weekStart}`);
        const data = await res.json();
        
        if (data.entries && Object.keys(data.entries).length > 0) {
          // Check if any entries have actual values
          const hasData = Object.values(data.entries).some(entry => entry.start || entry.end);
          
          if (hasData) {
            // Load saved data
            Object.keys(data.entries).forEach(day => {
              const entry = data.entries[day];
              setTimeToSelects(day, 'start', entry.start || '');
              setTimeToSelects(day, 'end', entry.end || '');
            });
          } else {
            // No saved data, pre-fill with defaults
            prefillWithDefaults();
          }
        } else {
          // No data for this week, pre-fill with defaults
          prefillWithDefaults();
        }
        
        calculateActualTotal();
      } catch (err) {
        console.error('Error loading week data:', err);
        prefillWithDefaults();
        calculateActualTotal();
      }
    }
    
    // Initialize week selector to current week
    document.addEventListener('DOMContentLoaded', () => {
      // Initialize time select dropdowns first
      initTimeSelects();
      
      const today = new Date();
      const weekInput = document.getElementById('weekSelector');
      const year = today.getFullYear();
      const weekNum = getWeekNumber(today);
      const currentWeek = `${year}-W${String(weekNum).padStart(2, '0')}`;
      weekInput.value = currentWeek;
      
      updateWeekDates();
      
      // Load data for current week (will pre-fill with defaults if no saved data)
      loadWeekData(currentWeek);
      
      // Add listeners to recalculate on select change
      document.querySelectorAll('.time-select').forEach(select => {
        select.addEventListener('change', () => {
          calculateActualTotal();
        });
      });
      
      // Week selector change listener - now also loads data
      weekInput.addEventListener('change', () => {
        updateWeekDates();
        loadWeekData(weekInput.value);
      });
      
      // Navigation buttons
      document.getElementById('prevWeekBtn').addEventListener('click', () => navigateWeek(-1));
      document.getElementById('nextWeekBtn').addEventListener('click', () => navigateWeek(1));
    });
    
    function getWeekNumber(date) {
      const d = new Date(Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()));
      const dayNum = d.getUTCDay() || 7;
      d.setUTCDate(d.getUTCDate() + 4 - dayNum);
      const yearStart = new Date(Date.UTC(d.getUTCFullYear(), 0, 1));
      return Math.ceil((((d - yearStart) / 86400000) + 1) / 7);
    }
    
    function getWeekStartDate(weekValue) {
      // weekValue format: "2026-W10"
      const [year, weekPart] = weekValue.split('-W');
      const weekNum = parseInt(weekPart);
      
      // ISO week date calculation: first Thursday of year determines week 1
      const jan4 = new Date(parseInt(year), 0, 4);
      const dayOfWeek = jan4.getDay() || 7; // Convert Sunday (0) to 7
      const firstMonday = new Date(jan4);
      firstMonday.setDate(jan4.getDate() - dayOfWeek + 1);
      
      // Add weeks
      const weekStart = new Date(firstMonday);
      weekStart.setDate(firstMonday.getDate() + (weekNum - 1) * 7);
      
      return weekStart;
    }
    
    function updateWeekDates() {
      const weekValue = document.getElementById('weekSelector').value;
      if (!weekValue) return;
      
      const weekStart = getWeekStartDate(weekValue);
      const weekNum = weekValue.split('-W')[1];
      
      // Update week number badge
      document.getElementById('weekNumberBadge').textContent = `${weekLabel} ${parseInt(weekNum)}`;
      
      // Update dates for each day
      days.forEach((day, index) => {
        const dayDate = new Date(weekStart);
        dayDate.setDate(weekStart.getDate() + index);
        
        const formattedDate = formatDate(dayDate);
        const dateEl = document.getElementById(`date-${day}`);
        if (dateEl) {
          dateEl.textContent = formattedDate;
        }
      });
    }
    
    function formatDate(date) {
      const day = date.getDate();
      const month = date.getMonth() + 1;
      return `${day.toString().padStart(2, '0')}/${month.toString().padStart(2, '0')}`;
    }
    
    function navigateWeek(direction) {
      const weekInput = document.getElementById('weekSelector');
      const currentValue = weekInput.value;
      
      if (!currentValue) return;
      
      const weekStart = getWeekStartDate(currentValue);
      weekStart.setDate(weekStart.getDate() + (direction * 7));
      
      const newYear = weekStart.getFullYear();
      const newWeekNum = getWeekNumber(weekStart);
      
      const newWeek = `${newYear}-W${String(newWeekNum).padStart(2, '0')}`;
      weekInput.value = newWeek;
      updateWeekDates();
      loadWeekData(newWeek);
    }
    
    function calculateActualTotal() {
      let totalMinutes = 0;
      
      days.forEach(day => {
        const startTime = getTimeFromSelects(day, 'start');
        const endTime = getTimeFromSelects(day, 'end');
        
        if (startTime && endTime) {
          const [sh, sm] = startTime.split(':').map(Number);
          const [eh, em] = endTime.split(':').map(Number);
          const startMin = sh * 60 + sm;
          const endMin = eh * 60 + em;
          
          if (endMin > startMin) {
            totalMinutes += (endMin - startMin);
          }
        }
      });
      
      const totalHours = totalMinutes / 60;
      
      document.getElementById('totalActual').textContent = `${totalHours.toFixed(2)} ${hoursLabel}`;
      
      const diff = totalHours - 32;
      const diffEl = document.getElementById('weekDifference');
      diffEl.textContent = `${diff >= 0 ? '+' : ''}${diff.toFixed(2)} ${hoursLabel}`;
      diffEl.className = diff >= 0 ? 'positive' : 'negative';
    }
    
    function setLanguage(lang) {
      fetch('/api/set-language', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ lang })
      }).then(() => window.location.reload());
    }
    
    function loadWeek(weekStart) {
      // Set week selector and update UI
      document.getElementById('weekSelector').value = weekStart;
      updateWeekDates();
      loadWeekData(weekStart);
    }
    
    document.getElementById('scheduleForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const weekStart = document.getElementById('weekSelector').value;
      const entries = {};
      
      days.forEach(day => {
        entries[day] = {
          start: getTimeFromSelects(day, 'start'),
          end: getTimeFromSelects(day, 'end')
        };
      });
      
      try {
        const res = await fetch('/api/week', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ weekStart, entries })
        });
        
        const data = await res.json();
        
        if (data.success) {
          const cumEl = document.getElementById('cumulativeValue');
          cumEl.textContent = `${data.cumulative >= 0 ? '+' : ''}${data.cumulative.toFixed(2)} ${hoursLabel}`;
          cumEl.className = `summary-value ${data.cumulative >= 0 ? 'positive' : 'negative'}`;
          
          const msgEl = document.getElementById('saveMessage');
          msgEl.classList.remove('hidden');
          setTimeout(() => msgEl.classList.add('hidden'), 3000);
          
          // Refresh page to update previous weeks list
          setTimeout(() => window.location.reload(), 1500);
        }
      } catch (err) {
        console.error('Save error:', err);
      }
    });
  </script>
</body>
</html>
